<Window x:Class="LogLens.App.ExportOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LogLens — Review export options" Style="{StaticResource {x:Type Window}}" Width="760" Height="620" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Heading" Text="Choose what to include" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Nothing is uploaded. A redacted preview is shown before saving. Review carefully: redaction cannot identify every private value." Style="{StaticResource Muted}" Margin="0,12,0,18"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <StackPanel x:Name="HistoryOptions"><CheckBox x:Name="IncludeHistory" Content="Include investigation history and outcomes for incidents in this report" Margin="0,0,0,16"/>
        <TextBlock Text="Review optional notes below before choosing to include them. These are your original local notes; the next preview applies redaction." Margin="0,0,0,10"/>
        <TextBox x:Name="NotesReview" IsReadOnly="True" VerticalContentAlignment="Top" Height="190" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Review original investigation notes"/>
        <CheckBox x:Name="IncludeNotes" Content="I reviewed these notes and choose to include them" IsEnabled="{Binding IsChecked, ElementName=IncludeHistory}" Margin="0,16,0,0"/>
      </StackPanel>
      <StackPanel x:Name="FeedbackOptions" Visibility="Collapsed"><TextBlock Text="What did LogLens get wrong, and what did you expect?" Margin="0,0,0,10"/><TextBox x:Name="ExpectedBehavior" MaxLength="2000" Height="220" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Expected or reported diagnostic behavior"/><TextBlock Text="The feedback includes minimized event identities, rule IDs and produced findings. Raw logs and investigation notes are omitted. You decide whether and where to share it." Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button Content="Continue to redacted preview" Click="ContinueClick" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
